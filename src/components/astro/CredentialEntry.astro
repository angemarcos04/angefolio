---
import type { HomepageCredential } from '../../lib/data/homepage';
import {
  credentialDateLabel,
  credentialIsExpired,
  credentialTypeLabels,
} from '../../lib/data/credentialPresentation';

interface Props {
  credential: HomepageCredential;
}

const { credential } = Astro.props;
const issueDate = credential.issuedAt
  ? credentialDateLabel(credential.issuedAt)
  : undefined;
const expiryDate = credential.expiresAt
  ? credentialDateLabel(credential.expiresAt)
  : undefined;
const expired = credential.expiresAt
  ? credentialIsExpired(credential.expiresAt)
  : undefined;
const image =
  credential.image?.startsWith('/') &&
  !credential.image.startsWith('//') &&
  !credential.image.includes('..')
    ? credential.image
    : undefined;
const verificationUrl = (() => {
  try {
    return credential.verificationUrl &&
      new URL(credential.verificationUrl).protocol === 'https:'
      ? credential.verificationUrl
      : undefined;
  } catch {
    return undefined;
  }
})();
const detailsId = `credential-details-${credential.id}`;
const collapsedLabel = `Show details for ${credential.title}`;
const expandedLabel = `Hide details for ${credential.title}`;
---

<article
  class="credential-row"
  data-credential-type={credential.type}
  data-credential-id={credential.id}
>
  <div class="credential-main">
    {
      image && (
        <span class="credential-thumb">
          <img
            src={image}
            alt={`${credential.title} badge artwork`}
            width="56"
            height="56"
            loading="lazy"
          />
        </span>
      )
    }
    <div class="credential-summary-copy">
      <span class="credential-title">{credential.title}</span>
      <span class="credential-meta">
        <span>{credential.issuer}</span>
        {
          issueDate && (
            <span>
              <span aria-hidden="true"> · </span>Issued{' '}
              <time datetime={credential.issuedAt!}>{issueDate}</time>
            </span>
          )
        }
      </span>
    </div>
    <button
      type="button"
      class="credential-toggle"
      aria-expanded="false"
      aria-controls={detailsId}
      aria-label={collapsedLabel}
      data-collapsed-label={collapsedLabel}
      data-expanded-label={expandedLabel}
      hidden
    >
      <span aria-hidden="true">⌄</span>
    </button>
  </div>

  <div class="credential-details" id={detailsId}>
    <dl>
      <div>
        <dt>Type</dt>
        <dd>{credentialTypeLabels[credential.type]}</dd>
      </div>
      {
        expiryDate && (
          <div>
            <dt>{expired ? 'Status' : 'Expires'}</dt>
            <dd>
              {expired ? 'Expired · ' : ''}
              <time datetime={credential.expiresAt!}>{expiryDate}</time>
            </dd>
          </div>
        )
      }
      {
        credential.credentialId && (
          <div class="credential-id-row">
            <dt>Credential ID</dt>
            <dd class="credential-id">{credential.credentialId}</dd>
          </div>
        )
      }
    </dl>
    {
      verificationUrl && (
        <div class="credential-actions">
          <a href={verificationUrl} target="_blank" rel="noopener noreferrer">
            View credential ↗
          </a>
        </div>
      )
    }
  </div>
</article>

<script>
  const credentialAccordionMedia = window.matchMedia('(max-width: 1023px)');
  const credentialRows =
    document.querySelectorAll<HTMLElement>('.credential-row');

  function syncCredentialRows() {
    const isExpandable = credentialAccordionMedia.matches;
    for (const row of credentialRows) {
      const details = row.querySelector<HTMLDivElement>('.credential-details');
      const toggle = row.querySelector<HTMLButtonElement>('.credential-toggle');
      if (!details || !toggle) continue;

      toggle.hidden = !isExpandable;
      if (!isExpandable) {
        row.classList.remove('is-expanded');
        details.hidden = false;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute(
          'aria-label',
          toggle.dataset.collapsedLabel ?? 'Show credential details',
        );
      } else {
        const expanded = row.classList.contains('is-expanded');
        details.hidden = !expanded;
        toggle.setAttribute('aria-expanded', String(expanded));
      }
    }
  }

  for (const row of credentialRows) {
    const toggle = row.querySelector<HTMLButtonElement>('.credential-toggle');
    const details = row.querySelector<HTMLDivElement>('.credential-details');
    if (!toggle || !details) continue;

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') !== 'true';
      row.classList.toggle('is-expanded', expanded);
      details.hidden = !expanded;
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.setAttribute(
        'aria-label',
        expanded
          ? (toggle.dataset.expandedLabel ?? 'Hide credential details')
          : (toggle.dataset.collapsedLabel ?? 'Show credential details'),
      );
    });
  }

  syncCredentialRows();
  credentialAccordionMedia.addEventListener('change', syncCredentialRows);
</script>

<style>
  .credential-row {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 13rem);
    align-items: center;
    gap: 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    transition: border-color 140ms ease;
  }
  .credential-row[hidden] {
    display: none;
  }
  .credential-row:hover {
    border-color: var(--border-strong);
  }
  .credential-main {
    display: flex;
    min-width: 0;
    min-height: 4.75rem;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0 0.7rem 0.9rem;
  }
  .credential-thumb {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 3.25rem;
    place-items: center;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #ece9e1;
  }
  .credential-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .credential-summary-copy {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 0.2rem;
  }
  .credential-title {
    color: var(--foreground);
    font: 600 0.9rem/1.4 var(--type-ui);
    overflow-wrap: anywhere;
  }
  .credential-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    color: var(--muted-foreground);
    font: 0.74rem/1.45 var(--type-body);
  }
  .credential-toggle {
    display: none;
  }
  .credential-details {
    display: grid;
    min-width: 0;
    gap: 0.3rem;
    padding: 0.6rem 0.9rem 0.6rem 0;
    border-left: 1px solid var(--border);
  }
  .credential-details[hidden],
  .credential-toggle[hidden] {
    display: none;
  }
  .credential-details dl {
    display: grid;
    gap: 0.22rem;
    margin: 0;
  }
  .credential-details dl > div {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
  }
  .credential-details dt {
    color: var(--subtle-foreground);
    font: 0.66rem/1.4 var(--font-mono);
  }
  .credential-details dd {
    min-width: 0;
    margin: 0;
    color: var(--muted-foreground);
    font: 0.73rem/1.4 var(--type-body);
    overflow-wrap: anywhere;
  }
  .credential-details .credential-id-row {
    display: none;
  }
  .credential-details .credential-id {
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }
  .credential-actions {
    display: flex;
    flex-wrap: wrap;
  }
  .credential-actions a {
    color: var(--accent-text);
    font: 0.72rem/1.45 var(--font-mono);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .credential-actions a:hover {
    color: var(--accent-hover);
  }
  .credential-actions a:focus-visible,
  .credential-toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  @media (max-width: 1023px) {
    .credential-row {
      display: block;
    }
    .credential-main {
      min-height: 4.5rem;
      gap: 0.65rem;
      padding: 0.65rem 0.75rem;
    }
    .credential-thumb {
      width: 3rem;
      height: 3rem;
      flex-basis: 3rem;
    }
    .credential-title {
      font-size: 0.82rem;
    }
    .credential-toggle {
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
      flex: 0 0 2.75rem;
      place-items: center;
      padding: 0;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--accent-text);
      font: 1rem/1 var(--font-mono);
      cursor: pointer;
    }
    .credential-toggle:hover {
      border-color: var(--border);
      background: var(--muted);
    }
    .credential-toggle span {
      transition: transform 140ms ease;
    }
    .credential-row.is-expanded {
      border-color: var(--border-strong);
      border-left: 2px solid var(--accent);
    }
    .credential-row.is-expanded .credential-toggle span {
      transform: rotate(180deg);
    }
    .credential-details {
      gap: 0.65rem;
      padding: 0.75rem;
      border-top: 1px solid var(--border);
      border-left: 0;
    }
    .credential-details .credential-id-row {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .credential-row,
    .credential-toggle span {
      transition: none;
    }
  }
</style>
