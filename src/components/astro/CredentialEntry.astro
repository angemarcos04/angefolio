---
import type { HomepageCredential } from '../../lib/data/homepage';
import {
  credentialDateLabel,
  credentialIsExpired,
  credentialTypeLabels,
} from '../../lib/data/credentialPresentation';

interface Props {
  credential: HomepageCredential;
}

const { credential } = Astro.props;
const issueDate = credential.issuedAt
  ? credentialDateLabel(credential.issuedAt)
  : undefined;
const expiryDate = credential.expiresAt
  ? credentialDateLabel(credential.expiresAt)
  : undefined;
const expired = credential.expiresAt
  ? credentialIsExpired(credential.expiresAt)
  : undefined;
const image =
  credential.image?.startsWith('/') &&
  !credential.image.startsWith('//') &&
  !credential.image.includes('..')
    ? credential.image
    : undefined;
const verificationUrl = (() => {
  try {
    return credential.verificationUrl &&
      new URL(credential.verificationUrl).protocol === 'https:'
      ? credential.verificationUrl
      : undefined;
  } catch {
    return undefined;
  }
})();
---

<details
  class="credential-row"
  data-credential-type={credential.type}
  data-credential-id={credential.id}
>
  <summary class="credential-summary">
    {
      image && (
        <span class="credential-thumb">
          <img
            src={image}
            alt={`${credential.title} badge artwork`}
            width="56"
            height="56"
            loading="lazy"
          />
        </span>
      )
    }
    <span class="credential-summary-copy">
      <span class="credential-title">{credential.title}</span>
      <span class="credential-meta">
        <span>{credential.issuer}</span>
        {
          issueDate && (
            <span>
              <span aria-hidden="true"> · </span>Issued{' '}
              <time datetime={credential.issuedAt!}>{issueDate}</time>
            </span>
          )
        }
      </span>
    </span>
    <span class="credential-chevron" aria-hidden="true">⌄</span>
  </summary>
  <div
    class:list={['credential-details', !image && 'credential-details-no-art']}
  >
    {
      image && (
        <div class="credential-large-art">
          <img src={image} alt="" width="144" height="144" loading="lazy" />
        </div>
      )
    }
    <div class="credential-detail-copy">
      <dl>
        <div><dt>Type</dt><dd>{credentialTypeLabels[credential.type]}</dd></div>
        {
          expiryDate && (
            <div>
              <>
                <dt>{expired ? 'Status' : 'Expires'}</dt>
                <dd>
                  {expired ? 'Expired · ' : ''}
                  <time datetime={credential.expiresAt!}>{expiryDate}</time>
                </dd>
              </>
            </div>
          )
        }
        {
          credential.credentialId && (
            <div>
              <>
                <dt>Credential ID</dt>
                <dd class="credential-id">{credential.credentialId}</dd>
              </>
            </div>
          )
        }
      </dl>
      <div class="credential-actions">
        {
          verificationUrl && (
            <a href={verificationUrl} target="_blank" rel="noopener noreferrer">
              View credential ↗
            </a>
          )
        }
      </div>
    </div>
  </div>
</details>

<style>
  .credential-row {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
  }
  .credential-row[hidden] {
    display: none;
  }
  .credential-row[open] {
    border-color: var(--border-strong);
    border-left: 2px solid var(--accent);
  }
  .credential-summary {
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    color: var(--foreground);
    cursor: pointer;
    list-style: none;
  }
  .credential-summary::-webkit-details-marker {
    display: none;
  }
  .credential-summary:focus-visible,
  .credential-actions a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -3px;
  }
  .credential-thumb {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    flex: 0 0 3.5rem;
    place-items: center;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #ece9e1;
  }
  .credential-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .credential-summary-copy {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 0.22rem;
  }
  .credential-title {
    color: var(--foreground);
    font: 600 0.88rem/1.4 var(--type-ui);
    overflow-wrap: anywhere;
  }
  .credential-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    color: var(--muted-foreground);
    font: 0.72rem/1.45 var(--type-body);
  }
  .credential-chevron {
    flex: 0 0 auto;
    color: var(--accent-text);
    font: 1rem/1 var(--font-mono);
    transition: transform 140ms ease;
  }
  .credential-row[open] .credential-chevron {
    transform: rotate(180deg);
  }
  .credential-details {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0 1rem 1rem;
    border-top: 1px solid var(--border);
  }
  .credential-details-no-art {
    grid-template-columns: minmax(0, 1fr);
  }
  .credential-large-art {
    display: grid;
    width: 9rem;
    height: 9rem;
    place-items: center;
    align-self: start;
    margin-top: 1rem;
    padding: 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #ece9e1;
  }
  .credential-large-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .credential-detail-copy {
    min-width: 0;
    padding-top: 0.85rem;
  }
  .credential-detail-copy dl {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }
  .credential-detail-copy dl > div {
    display: grid;
    grid-template-columns: minmax(5.5rem, 8rem) minmax(0, 1fr);
    gap: 0.6rem;
  }
  .credential-detail-copy dt {
    color: var(--subtle-foreground);
    font: 0.68rem/1.45 var(--font-mono);
  }
  .credential-detail-copy dd {
    min-width: 0;
    margin: 0;
    color: var(--muted-foreground);
    font: 0.78rem/1.45 var(--type-body);
    overflow-wrap: anywhere;
  }
  .credential-detail-copy .credential-id {
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .credential-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.9rem;
  }
  .credential-actions a {
    color: var(--accent-text);
    font: 0.7rem/1.45 var(--font-mono);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .credential-actions a:hover {
    color: var(--accent-hover);
  }
  @media (max-width: 767px) {
    .credential-summary {
      min-height: 4.5rem;
      gap: 0.65rem;
      padding: 0.65rem 0.75rem;
    }
    .credential-thumb {
      width: 3rem;
      height: 3rem;
      flex-basis: 3rem;
    }
    .credential-title {
      font-size: 0.82rem;
    }
    .credential-details {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.75rem;
    }
    .credential-large-art {
      width: 5rem;
      height: 5rem;
      margin-top: 0;
    }
    .credential-detail-copy {
      padding-top: 0;
    }
    .credential-detail-copy dl > div {
      grid-template-columns: minmax(5rem, 6.5rem) minmax(0, 1fr);
      gap: 0.45rem;
    }
  }
  @media (min-width: 768px) {
    .credential-details {
      padding-left: 1.15rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .credential-chevron {
      transition: none;
    }
  }
</style>
