---
import type { HomepageAffiliation } from '../../lib/data/homepage';

interface Props {
  affiliation: HomepageAffiliation;
}

const { affiliation } = Astro.props;
---

<li class="affiliation-entry">
  {
    affiliation.url ? (
      <a
        class="affiliation-card"
        href={affiliation.url}
        target="_blank"
        rel="noreferrer"
      >
        <img
          src={affiliation.logo}
          alt={affiliation.name}
          width="40"
          height="40"
          loading="lazy"
        />
        <span class="affiliation-copy">
          <span class="affiliation-name">{affiliation.name}</span>
          <span class="affiliation-relationship">
            {affiliation.relationship}
          </span>
        </span>
      </a>
    ) : (
      <div class="affiliation-card">
        <img
          src={affiliation.logo}
          alt={affiliation.name}
          width="40"
          height="40"
          loading="lazy"
        />
        <span class="affiliation-copy">
          <span class="affiliation-name">{affiliation.name}</span>
          <span class="affiliation-relationship">
            {affiliation.relationship}
          </span>
        </span>
      </div>
    )
  }
</li>

<style>
  .affiliation-entry {
    min-width: 0;
    margin: 0;
    padding: 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .affiliation-card {
    display: flex;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }
  a.affiliation-card:hover .affiliation-name {
    color: var(--accent-hover);
  }
  img {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 2.5rem;
    object-fit: contain;
  }
  .affiliation-copy {
    display: grid;
    min-width: 0;
    gap: 0.2rem;
  }
  .affiliation-name {
    color: var(--foreground);
    font: 0.8rem/1.3 var(--type-ui);
    overflow-wrap: anywhere;
  }
  .affiliation-relationship {
    color: var(--muted-foreground);
    font: 0.68rem/1.35 var(--font-mono);
    overflow-wrap: anywhere;
  }
</style>
