---
import CompactTagList from './CompactTagList.astro';
import StatusPill from './StatusPill.astro';
import Tag from './Tag.astro';
import { formatDate } from '../../lib/date';

interface Props {
  title: string;
  description: string;
  status: string;
  tags: string[];
  date: Date | string;
  href?: string;
  category?: string;
  tools?: string[];
  featured?: boolean;
  context?: 'home' | 'archive';
  class?: string;
}

const {
  title,
  description,
  status,
  tags,
  date,
  href,
  category,
  tools = [],
  featured = false,
  context = 'archive',
  class: className = '',
} = Astro.props;
const dateValue = new Date(date);
const visibleTools = context === 'home' ? tools.slice(0, 3) : tools;
const toolOverflow = context === 'home' ? Math.max(0, tools.length - 3) : 0;
const visibleTags = context === 'home' ? tags.slice(0, 3) : tags;
const tagOverflow = context === 'home' ? Math.max(0, tags.length - 3) : 0;
---

<article
  class:list={[
    'content-card bento-surface lab-card',
    context === 'home' && 'home-preview',
    className,
  ]}
>
  <div class="lab-meta">
    <StatusPill {status} />
    {category && <Tag tone="accent">{category}</Tag>}
    {context === 'archive' && featured && <Tag tone="strong">Featured</Tag>}
    <time datetime={dateValue.toISOString()}>{formatDate(dateValue)}</time>
  </div>
  {
    context === 'home' ? (
      <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    ) : (
      <h2>{href ? <a href={href}>{title}</a> : title}</h2>
    )
  }
  <p>{description}</p>
  {
    (tools.length > 0 || tags.length > 0) && (
      <div class="lab-taxonomy">
        {visibleTools.length > 0 && (
          <div class="lab-tool-list">
            <span class="lab-label">tools</span>
            <CompactTagList
              items={visibleTools}
              label="tools"
              class="lab-tags"
            />
            {toolOverflow > 0 && (
              <Tag class="lab-more">
                +{toolOverflow}
                <span class="sr-only">
                  , additional tools: {tools.slice(3).join(', ')}
                </span>
              </Tag>
            )}
          </div>
        )}
        {(context === 'archive' || tools.length === 0) &&
          (visibleTags.length > 0 || tagOverflow > 0) && (
            <div class="lab-tool-list">
              <span class="lab-label">tags</span>
              <CompactTagList
                items={visibleTags}
                label="tags"
                class="lab-tags"
              />
              {tagOverflow > 0 && (
                <Tag class="lab-more">
                  +{tagOverflow}
                  <span class="sr-only">
                    , additional tags: {tags.slice(3).join(', ')}
                  </span>
                </Tag>
              )}
            </div>
          )}
      </div>
    )
  }
</article>

<style>
  .lab-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.2rem;
    border-left: 2px solid var(--accent);
  }
  .lab-meta {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .lab-meta time {
    margin-left: auto;
    color: var(--muted-foreground);
    font: 0.68rem/1.4 var(--font-mono);
  }
  h2,
  h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  h2 a,
  h3 a {
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  h2 a:hover,
  h2 a:focus-visible,
  h3 a:hover,
  h3 a:focus-visible {
    color: var(--accent-text);
    text-decoration: underline;
  }
  h2 a:focus-visible,
  h3 a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.88rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .home-preview > p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .lab-taxonomy {
    display: grid;
    gap: 0.45rem;
    margin-top: auto;
  }
  .lab-tool-list {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .lab-label {
    color: var(--subtle-foreground);
    font: 0.66rem/1.4 var(--font-mono);
  }
  .lab-more {
    flex: none;
  }
  @media (max-width: 767px) {
    .lab-card {
      gap: 0.6rem;
      padding: 1rem;
    }
    .lab-meta time {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
