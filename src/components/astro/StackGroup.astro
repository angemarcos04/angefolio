---
import Tag from './Tag.astro';
import { technologyIconsFor } from '../../lib/data/technologyIcons';
interface Props {
  title: string;
  items: string[];
  class?: string;
}
const { title, items, class: className = '' } = Astro.props;
---

<section class:list={['stack-group', className]}>
  <h3>{title}</h3>
  <div>
    {
      items.map((item) => (
        <Tag class="stack-tag">
          {technologyIconsFor(item).map((icon) => (
            <img src={icon} alt="" width="20" height="20" loading="lazy" />
          ))}
          <span>{item}</span>
        </Tag>
      ))
    }
  </div>
</section>
<style>
  .stack-group h3 {
    margin: 0 0 0.55rem;
    color: var(--muted-foreground);
    font: 0.68rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stack-group div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .stack-group :global(.stack-tag) {
    min-height: 2rem;
    gap: 0.4rem;
    padding: 0.18rem 0.6rem;
    color: var(--foreground);
    font-size: 0.74rem;
  }
  .stack-group :global(.stack-tag img) {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    object-fit: contain;
  }
  @media (max-width: 767px) {
    .stack-group h3 {
      margin-bottom: 0.4rem;
      font-size: 0.74rem;
      letter-spacing: 0.04em;
    }
    .stack-group div {
      gap: 0.3rem;
    }
    .stack-group :global(.tag) {
      font-size: 0.75rem;
    }
    .stack-group :global(.stack-tag) {
      min-height: 1.9rem;
      gap: 0.3rem;
      padding-inline: 0.48rem;
    }
    .stack-group :global(.stack-tag img) {
      width: 1.125rem;
      height: 1.125rem;
    }
  }
</style>
