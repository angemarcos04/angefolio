---
import ThemeToggle from '../svelte/ThemeToggle.svelte';
import {
  collectionNavigationRoutes,
  primaryPublicRoutes,
} from '../../lib/data/publicNavigation';

interface Props {
  active?: 'home' | 'projects' | 'notes' | 'blog' | 'lab' | 'search';
}

const { active } = Astro.props;
const routes =
  active === 'home' ? collectionNavigationRoutes : primaryPublicRoutes;
---

<header class="collection-topbar" data-pagefind-ignore>
  <div class="topbar-actions">
    <nav aria-label="Primary navigation">
      {
        routes.map((item) => (
          <a
            href={item.href}
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle client:load />
  </div>
</header>

<style>
  .collection-topbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .topbar-actions,
  nav {
    display: flex;
    align-items: center;
  }
  .topbar-actions {
    max-width: 100%;
    justify-content: flex-end;
    gap: 0.9rem;
    margin-left: auto;
  }
  nav {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  nav a {
    display: inline-flex;
    min-height: 2.6rem;
    align-items: center;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    font: 600 0.9rem/1.25 var(--type-ui);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  @media (max-width: 760px) {
    .topbar-actions {
      align-items: flex-end;
      flex-direction: column-reverse;
      gap: 0.45rem;
    }
  }
</style>
