---
import CompactTagList from './CompactTagList.astro';
import Tag from './Tag.astro';
import { formatDate } from '../../lib/notes';

interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  createdAt: Date | string;
  updatedAt?: Date | string;
  href?: string;
  featured?: boolean;
  context?: 'home' | 'archive';
  class?: string;
}

const {
  title,
  description,
  category,
  tags,
  createdAt,
  updatedAt,
  href,
  featured = false,
  context = 'archive',
  class: className = '',
} = Astro.props;
const dateValue = new Date(createdAt);
const updatedValue = updatedAt ? new Date(updatedAt) : null;
const tagLimit = context === 'home' ? 3 : tags.length;
---

<article
  class:list={[
    'content-card bento-surface note-card',
    context === 'home' && 'home-preview',
    className,
  ]}
>
  <div class="note-meta">
    <Tag tone="accent">{category}</Tag>
    {context === 'archive' && featured && <Tag tone="strong">Featured</Tag>}
  </div>
  {
    context === 'home' ? (
      <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    ) : (
      <h2>{href ? <a href={href}>{title}</a> : title}</h2>
    )
  }
  <p>{description}</p>
  <CompactTagList
    items={tags}
    limit={tagLimit}
    label="tags"
    class="note-tags"
  />
  <small class="note-date">
    <time datetime={dateValue.toISOString()}>{formatDate(dateValue)}</time>
    {
      updatedValue && updatedValue.getTime() !== dateValue.getTime() && (
        <span>
          Updated{' '}
          <time datetime={updatedValue.toISOString()}>
            {formatDate(updatedValue)}
          </time>
        </span>
      )
    }
  </small>
</article>

<style>
  .note-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.15rem;
  }
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  h2,
  h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  h2 a,
  h3 a {
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  h2 a:hover,
  h2 a:focus-visible,
  h3 a:hover,
  h3 a:focus-visible {
    color: var(--accent-text);
    text-decoration: underline;
  }
  h2 a:focus-visible,
  h3 a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.88rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .home-preview > p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .note-tags {
    margin-top: auto;
  }
  .note-date {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.25rem;
    color: var(--muted-foreground);
    font: 0.68rem/1.4 var(--font-mono);
  }
  @media (max-width: 767px) {
    .note-card {
      gap: 0.55rem;
      padding: 1rem;
    }
  }
</style>
