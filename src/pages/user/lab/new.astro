---
import ConsoleShell from '../../../components/astro/ConsoleShell.astro';
import LabForm from '../../../components/astro/LabForm.astro';
import SectionHeader from '../../../components/astro/SectionHeader.astro';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/user/login');
---

<ConsoleShell
  title="New experiment — Angellie Marcos"
  description="Write a Lab entry."
  active="lab"
  {user}
>
  <SectionHeader
    eyebrow="Private / Lab"
    title="New experiment"
    description="Record the current state and what you learned."
    headingLevel={1}
  />
  <LabForm action="/api/console/lab/save" submitLabel="Save experiment" />
</ConsoleShell>
