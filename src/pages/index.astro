---
import BentoCard from '../components/astro/BentoCard.astro';
import AffiliationCard from '../components/astro/AffiliationCard.astro';
import BentoGrid from '../components/astro/BentoGrid.astro';
import BlogCard from '../components/astro/BlogCard.astro';
import Button from '../components/astro/Button.astro';
import CollectionHeader from '../components/astro/CollectionHeader.astro';
import IconLink from '../components/astro/IconLink.astro';
import Layout from '../components/astro/Layout.astro';
import LabCard from '../components/astro/LabCard.astro';
import NoteCard from '../components/astro/NoteCard.astro';
import ProjectCard from '../components/astro/ProjectCard.astro';
import ResumeViewer from '../components/astro/ResumeViewer.astro';
import StackGroup from '../components/astro/StackGroup.astro';
import HomeProgressRail from '../components/svelte/HomeProgressRail.svelte';
import PortfolioTerminal from '../components/svelte/PortfolioTerminal.svelte';
import { contactLinks, nowItems } from '../lib/data/home';
import { getHomepageConfig } from '../lib/server/homepage';
import { getPublicSiteSettings } from '../lib/server/siteSettings';
import { homeProgressSections } from '../lib/data/homeProgress';
import { getPublicNoteCatalog } from '../lib/server/notes';
import { getPublicBlogCatalog } from '../lib/server/blog';
import { getPublicLabCatalog } from '../lib/server/lab';
import { getPublicNowStatus } from '../lib/server/now';
import { getGitHubContributions } from '../lib/server/githubContributions';
import {
  getPublicProjectCatalog,
  publicProjectUrl,
} from '../lib/server/publicProjects';
import type {
  PortfolioTerminalData,
  TerminalNote,
  TerminalProject,
} from '../lib/terminal/types';
import { selectLatestPublicUpdate } from '../lib/terminal/updates';
import {
  credentialTypeLabels,
  getCredentialSpotlight,
} from '../lib/data/credentialPresentation';

const [homepage, publicSettings] = await Promise.all([
  getHomepageConfig(),
  getPublicSiteSettings(),
]);
const liveContactLinks = contactLinks.map((link) => ({
  ...link,
  href:
    link.label === 'Email'
      ? `mailto:${publicSettings.email}`
      : link.label === 'GitHub'
        ? publicSettings.github
        : link.href,
}));
const cards = homepage.cards;
const [
  projectCatalog,
  publishedNotes,
  publishedBlog,
  visibleLab,
  publicNowStatus,
  githubContributions,
] = await Promise.all([
  getPublicProjectCatalog(),
  getPublicNoteCatalog(),
  getPublicBlogCatalog(),
  getPublicLabCatalog(),
  getPublicNowStatus(),
  getGitHubContributions(publicSettings.github),
]);
const allProjects = projectCatalog.map((project) => {
  const detailUrl = publicProjectUrl(project);
  return {
    slug: project.slug,
    href: detailUrl,
    url: detailUrl,
    title: project.title,
    description: project.description,
    status: project.status,
    stack: project.stack,
    links: project.links,
    github: project.github ?? undefined,
    demo: project.demo ?? undefined,
    caseStudy:
      project.source === 'mdx' ? project.entry?.data.caseStudy : detailUrl,
    category: project.category ?? undefined,
    featured: project.featured,
    cover: project.cover,
    updatedAt: project.updatedAt.toISOString(),
  };
});
const preview = <T,>(entries: T[], limit: number): T[] =>
  limit === 0 ? entries : entries.slice(0, limit);
const featuredProjects = preview(
  allProjects.filter((project) => project.featured),
  homepage.projectLimit,
);
const featuredNotes = preview(
  publishedNotes.filter((note) => note.featured),
  homepage.noteLimit,
);
const featuredBlog = preview(
  publishedBlog.filter((post) => post.featured),
  homepage.blogLimit,
);
const featuredLab = preview(
  visibleLab.filter((entry) => entry.featured),
  homepage.labLimit,
);
const spotlightCredential = getCredentialSpotlight(homepage.credentials);
const safeCredentialUrl = (value: string | null): string | undefined => {
  if (!value) return undefined;
  try {
    return new URL(value).protocol === 'https:' ? value : undefined;
  } catch {
    return undefined;
  }
};
const showCredentialsCard =
  homepage.cards.credentials.visible && Boolean(spotlightCredential);
const showContactCard = homepage.cards.contact.visible;
const renderedNowItems = publicNowStatus?.items ?? nowItems;
const nowMetadata = publicNowStatus
  ? (publicNowStatus.statusNote ??
    `Updated ${publicNowStatus.updatedAt.toLocaleDateString('en', {
      dateStyle: 'medium',
    })}.`)
  : 'Static fallback.';
const terminalProjects: TerminalProject[] = allProjects.map(
  ({ href: _href, caseStudy: _caseStudy, ...project }) => project,
);
const terminalNotes: TerminalNote[] = publishedNotes.map((note) => ({
  slug: note.slug,
  title: note.title,
  summary: note.summary ?? note.description,
  url: `/notes/${note.slug}`,
  createdAt: note.createdAt.toISOString(),
  updatedAt: note.updatedAt?.toISOString(),
}));
const buildCommit =
  process.env.RENDER_GIT_COMMIT ??
  import.meta.env.VERCEL_GIT_COMMIT_SHA ??
  import.meta.env.CF_PAGES_COMMIT_SHA ??
  import.meta.env.GITHUB_SHA;
const buildBranch =
  import.meta.env.VERCEL_GIT_COMMIT_REF ??
  import.meta.env.CF_PAGES_BRANCH ??
  import.meta.env.GITHUB_REF_NAME;
const buildDate = import.meta.env.BUILD_DATE;
const latestUpdate = selectLatestPublicUpdate(terminalNotes, terminalProjects);
const terminalData: PortfolioTerminalData = {
  name: homepage.heroName,
  username: 'ange',
  hostname: 'angefolio',
  email: publicSettings.email,
  github: publicSettings.github,
  repositoryUrl: `${publicSettings.github}/angefolio`,
  about: homepage.aboutParagraphs.join(' '),
  nowItems: renderedNowItems,
  projects: terminalProjects,
  notes: terminalNotes,
  socials: liveContactLinks.map((link) => ({
    label: link.label,
    url: link.href,
  })),
  stack: homepage.stackGroups,
  routes: {
    home: '/',
    projects: '/projects',
    notes: '/notes',
    lab: '/lab',
    search: '/search',
    contact: '/#contact',
  },
  buildCommit,
  buildBranch,
  buildDate,
  latestUpdate,
  portfolioSince: 2023,
};
const showNowCard = cards.now.visible && renderedNowItems.length > 0;
const showStackCard = cards.stack.visible;
const showActivityCard = cards.activity.visible;
const desktopDashboardSpans = { now: 0, stack: 0, activity: 0 };
if (showNowCard && showStackCard && showActivityCard) {
  Object.assign(desktopDashboardSpans, { now: 3, stack: 5, activity: 4 });
} else if (showNowCard && showStackCard) {
  Object.assign(desktopDashboardSpans, { now: 4, stack: 8 });
} else if (showNowCard && showActivityCard) {
  Object.assign(desktopDashboardSpans, { now: 8, activity: 4 });
} else if (showStackCard && showActivityCard) {
  Object.assign(desktopDashboardSpans, { stack: 8, activity: 4 });
} else if (showNowCard) {
  desktopDashboardSpans.now = 12;
} else if (showStackCard) {
  desktopDashboardSpans.stack = 12;
} else if (showActivityCard) {
  desktopDashboardSpans.activity = 12;
}
const progressSections = homeProgressSections.filter((section) => {
  if (section.id === 'introduction') return true;
  if (section.id === 'featured-projects')
    return cards.projects.visible && featuredProjects.length > 0;
  if (section.id === 'current-focus') return showNowCard || showStackCard;
  if (section.id === 'github-activity') return showActivityCard;
  if (section.id === 'latest-notes')
    return cards.notes.visible && featuredNotes.length > 0;
  if (section.id === 'featured-blog')
    return cards.blog.visible && featuredBlog.length > 0;
  if (section.id === 'featured-lab')
    return cards.lab.visible && featuredLab.length > 0;
  if (section.id === 'contact') return cards.contact.visible;
  return false;
});
---

<Layout
  title={`${publicSettings.name} — ${publicSettings.siteName}`}
  description={publicSettings.seoDescription}
>
  <HomeProgressRail client:load sections={progressSections} />
  <CollectionHeader active="home" />
  <BentoGrid class="homepage-grid">
    <div
      id="introduction"
      class:list={[
        'desktop-introduction-grid home-anchor md:col-span-2 lg:col-span-12',
        cards.about.visible ? 'has-about' : 'without-about',
      ]}
    >
      <BentoCard class="hero subtle-grid" accent="strong">
        <div class="desktop-profile-stack">
          <BentoCard class="desktop-profile-tile subtle-grid" accent="strong">
            <div class="hero-intro">
              <div class="hero-copy">
                <h1 class="hero-heading text-balance">{homepage.heroName}</h1>
                <div class="actions">
                  <Button href="/projects" variant="primary">Projects</Button>
                  <Button
                    href={'mailto:' + publicSettings.email}
                    variant="ghost">Email</Button
                  >
                  <ResumeViewer />
                </div>
              </div>
              <figure class="hero-portrait">
                <div class="hero-portrait-titlebar" aria-hidden="true">
                  <span class="hero-portrait-controls">
                    <span class="hero-portrait-control"></span>
                    <span class="hero-portrait-control"></span>
                    <span class="hero-portrait-control"></span>
                  </span>
                  <span class="hero-portrait-filename">portrait.jpg</span>
                </div>
                <img
                  src={homepage.portrait}
                  alt={homepage.heroName}
                  width="460"
                  height="460"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  class="hero-portrait-image"
                />
              </figure>
            </div>
          </BentoCard>
          <BentoCard class="desktop-terminal-tile">
            <PortfolioTerminal client:load data={terminalData} />
          </BentoCard>
        </div>
      </BentoCard>

      {
        cards.about.visible && (
          <BentoCard
            class="about"
            accent="soft"
            eyebrow={cards.about.eyebrow}
            title={cards.about.title}
          >
            {homepage.aboutParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <section
              class="about-affiliations"
              aria-label="Education and affiliations"
            >
              <h3>Education &amp; Involvement</h3>
              <ul class="about-affiliation-list" data-affiliation-gallery>
                {homepage.affiliations.map((affiliation, index) => (
                  <AffiliationCard affiliation={affiliation} index={index} />
                ))}
              </ul>
            </section>
          </BentoCard>
        )
      }
    </div>
    {
      cards.projects.visible && featuredProjects.length > 0 && (
        <BentoCard
          id="featured-projects"
          class="projects home-anchor md:col-span-2 lg:col-span-12"
          accent="strong"
          eyebrow={cards.projects.eyebrow}
          title={cards.projects.title}
          description={cards.projects.description}
        >
          <div class="project-grid">
            {featuredProjects.map((project) => (
              <ProjectCard
                href={project.href}
                title={project.title}
                description={project.description}
                status={project.status}
                stack={project.stack}
                github={project.github}
                demo={project.demo}
                caseStudy={project.caseStudy}
                category={project.category}
                featured={project.featured}
                cover={project.cover}
                links={project.links}
                context="home"
              />
            ))}
          </div>
          <div class="card-footer">
            <IconLink href="/projects" label="View all projects" />
          </div>
        </BentoCard>
      )
    }
    {
      showNowCard && (
        <BentoCard
          id="current-focus"
          class="now home-anchor md:col-span-1 dashboard-card"
          style={`--dashboard-span: ${desktopDashboardSpans.now}`}
          accent="medium"
          eyebrow={cards.now.eyebrow}
          title={cards.now.title}
          description={cards.now.description || undefined}
        >
          <ul class="status-list">
            {renderedNowItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="metadata">{nowMetadata}</p>
        </BentoCard>
      )
    }

    {
      showStackCard && (
        <BentoCard
          id={!showNowCard ? 'current-focus' : undefined}
          class="stack md:col-span-1 dashboard-card"
          style={`--dashboard-span: ${desktopDashboardSpans.stack}`}
          accent="soft"
          eyebrow={cards.stack.eyebrow}
          title={cards.stack.title}
          description={cards.stack.description || undefined}
        >
          <div class="stack-groups">
            {homepage.stackGroups.map((group) => (
              <StackGroup title={group.title} items={group.items} />
            ))}
          </div>
        </BentoCard>
      )
    }

    {
      showActivityCard && (
        <BentoCard
          id="github-activity"
          class="github home-anchor md:col-span-2 dashboard-card"
          style={`--dashboard-span: ${desktopDashboardSpans.activity}`}
          accent="medium"
          eyebrow={cards.activity.eyebrow}
          title={cards.activity.title}
        >
          <p>{cards.activity.description}</p>
          {githubContributions ? (
            <>
              <div
                class="contribution-scroll"
                role="img"
                aria-label={`GitHub reports ${githubContributions.total}. Contribution activity for the past year.`}
              >
                <div class="contribution-grid" aria-hidden="true">
                  {githubContributions.days.map((day) => (
                    <span
                      class={`level-${day.level}`}
                      style={`grid-column: ${day.week + 1}; grid-row: ${day.weekday + 1};`}
                      title={`${day.date}: activity level ${day.level} of 4`}
                    />
                  ))}
                </div>
              </div>
            </>
          ) : (
            <p class="activity-unavailable">
              GitHub contribution activity is temporarily unavailable.
            </p>
          )}
          <div class="activity-meta" aria-label="GitHub profile">
            <span>
              {new URL(publicSettings.github).pathname.replaceAll('/', '')}
            </span>
            {githubContributions && <span>{githubContributions.total}</span>}
          </div>
          <IconLink href={publicSettings.github} label="GitHub" external />
        </BentoCard>
      )
    }
    {
      cards.notes.visible && featuredNotes.length > 0 && (
        <BentoCard
          id="latest-notes"
          class="notes home-anchor md:col-span-2 lg:col-span-8"
          accent="soft"
          eyebrow={cards.notes.eyebrow}
          title={cards.notes.title}
          description={cards.notes.description || undefined}
        >
          <div class="note-grid">
            {featuredNotes.map((note) => (
              <NoteCard
                href={`/notes/${note.slug}`}
                title={note.title}
                description={note.summary ?? note.description}
                category={note.category}
                tags={note.tags}
                createdAt={note.createdAt}
                updatedAt={note.updatedAt ?? undefined}
                featured={note.featured}
                context="home"
              />
            ))}
          </div>
          <div class="card-footer">
            <IconLink href="/notes" label="Read notes" />
          </div>
        </BentoCard>
      )
    }
    {
      cards.blog.visible && featuredBlog.length > 0 && (
        <BentoCard
          id="featured-blog"
          class="blog home-anchor md:col-span-1 lg:col-span-6"
          accent="soft"
          eyebrow={cards.blog.eyebrow}
          title={cards.blog.title}
          description={cards.blog.description || undefined}
        >
          <div class="blog-preview-grid">
            {featuredBlog.map((post) => (
              <BlogCard
                href={`/blog/${post.slug}`}
                title={post.title}
                description={post.description}
                summary={post.summary}
                cover={post.cover}
                category={post.category}
                tags={post.tags}
                createdAt={post.createdAt}
                updatedAt={post.updatedAt}
                featured={post.featured}
                context="home"
              />
            ))}
          </div>
          <div class="card-footer">
            <IconLink href="/blog" label="Read blog" />
          </div>
        </BentoCard>
      )
    }
    {
      cards.lab.visible && featuredLab.length > 0 && (
        <BentoCard
          id="featured-lab"
          class="lab home-anchor md:col-span-1 lg:col-span-6"
          accent="soft"
          eyebrow={cards.lab.eyebrow}
          title={cards.lab.title}
          description={cards.lab.description || undefined}
        >
          <div class="lab-preview-grid">
            {featuredLab.map((entry) => (
              <LabCard
                href={`/lab/${entry.slug}`}
                title={entry.title}
                description={entry.description}
                status={entry.status}
                category={entry.category ?? undefined}
                tags={entry.tags}
                tools={entry.tools}
                date={entry.date}
                featured={entry.featured}
                context="home"
              />
            ))}
          </div>
          <div class="card-footer">
            <IconLink href="/lab" label="Explore Lab" />
          </div>
        </BentoCard>
      )
    }

    {
      showCredentialsCard && (
        <BentoCard
          class="credentials md:col-span-2 dashboard-card"
          style={`--dashboard-span: ${showContactCard ? 8 : 12}`}
          accent="soft"
          eyebrow={cards.credentials.eyebrow}
          title={cards.credentials.title}
        >
          <div class="credential-spotlight">
            {spotlightCredential?.image && (
              <div class="credential-spotlight-art">
                <img
                  src={spotlightCredential.image}
                  alt={`${spotlightCredential.title} badge artwork`}
                  width="120"
                  height="120"
                  loading="lazy"
                />
              </div>
            )}
            <div class="credential-spotlight-copy">
              <h3>{spotlightCredential?.title}</h3>
              <p>{spotlightCredential?.issuer}</p>
              {spotlightCredential && (
                <span class="credential-type">
                  {credentialTypeLabels[spotlightCredential.type]}
                </span>
              )}
              {spotlightCredential &&
                safeCredentialUrl(spotlightCredential.verificationUrl) && (
                  <a
                    class="credential-verify"
                    href={safeCredentialUrl(
                      spotlightCredential.verificationUrl,
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View credential ↗
                  </a>
                )}
            </div>
          </div>
          <div class="credential-spotlight-footer">
            <a href="/credentials">All credentials →</a>
          </div>
        </BentoCard>
      )
    }

    {
      showContactCard && (
        <BentoCard
          id="contact"
          class:list={[
            'contact home-anchor md:col-span-2',
            showCredentialsCard ? 'lg:col-span-4' : 'lg:col-span-12',
          ]}
          accent="strong"
          eyebrow={cards.contact.eyebrow}
          title={cards.contact.title}
        >
          <p>{cards.contact.description}</p>
          <div class="contact-links">
            {liveContactLinks.map((link) => (
              <IconLink
                href={link.href}
                label={link.label}
                external={link.external}
              />
            ))}
          </div>
          <p class="contact-email">angellie.marcos0104@protonmail.me</p>
        </BentoCard>
      )
    }
  </BentoGrid>
</Layout>
<style>
  .desktop-introduction-grid {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  .actions {
    display: flex;
    align-items: center;
  }
  :global(.homepage-grid) {
    align-items: stretch;
  }
  :global(.hero) {
    display: flex;
    flex-direction: column;
  }
  .hero-intro {
    display: grid;
    grid-template-columns: clamp(10.5rem, 20vw, 13rem) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero-portrait {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 13rem;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--terminal-background);
  }
  .hero-portrait-titlebar {
    display: flex;
    min-height: 1.85rem;
    align-items: center;
    gap: 0.55rem;
    padding-inline: 0.65rem;
    border-bottom: 1px solid var(--border);
    background: var(--terminal-background);
    color: var(--terminal-muted);
  }
  .hero-portrait-controls {
    display: inline-flex;
    flex: none;
    gap: 0.3rem;
  }
  .hero-portrait-control {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: color-mix(
      in srgb,
      var(--accent) 25%,
      var(--terminal-background)
    );
  }
  .hero-portrait-control:nth-child(2) {
    background: var(--accent);
    opacity: 0.75;
  }
  .hero-portrait-control:nth-child(3) {
    background: var(--terminal-accent);
    opacity: 0.5;
  }
  .hero-portrait-filename {
    min-width: 0;
    overflow: hidden;
    color: var(--terminal-muted);
    font: 500 0.66rem var(--type-code);
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-portrait-image {
    display: block;
    width: 100%;
    min-height: 0;
    flex: 1;
    object-fit: cover;
    object-position: center;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-heading {
    max-width: 18ch;
    margin: 0 0 0.85rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: 0.01em;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-intro {
      grid-template-areas: 'portrait copy';
    }
    .hero-portrait {
      grid-area: portrait;
    }
    .hero-copy {
      grid-area: copy;
    }
  }
  :global(.home-anchor) {
    scroll-margin-top: clamp(1.5rem, 4vw, 3rem);
  }
  .about p,
  .github > p,
  .contact > p {
    color: var(--muted-foreground);
  }
  .actions {
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .actions {
    margin-top: 1.2rem;
  }
  @media (min-width: 1024px) {
    .desktop-introduction-grid.has-about {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    :global(.desktop-introduction-grid.without-about) {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.desktop-introduction-grid > .hero) {
      display: contents;
    }
    :global(.desktop-introduction-grid > .hero::before) {
      display: none;
    }
    .desktop-profile-stack {
      display: grid;
      min-width: 0;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 1rem;
    }
    :global(
      .desktop-introduction-grid .desktop-profile-stack > .desktop-profile-tile
    ) {
      padding: 1.25rem;
    }
    :global(
      .desktop-introduction-grid .desktop-profile-stack > .desktop-terminal-tile
    ) {
      padding: 0.875rem;
    }
    :global(.desktop-terminal-tile .terminal-preview) {
      margin-top: 0;
    }
    :global(.desktop-introduction-grid > .about) {
      align-self: start;
      min-width: 0;
    }
    :global(.homepage-grid .dashboard-card) {
      grid-column: span var(--dashboard-span);
    }
    .hero-intro {
      grid-template-columns: minmax(0, 1fr) minmax(9.375rem, 11.875rem);
      grid-template-areas: 'copy portrait';
      align-items: start;
      gap: clamp(0.75rem, 1.6vw, 1.25rem);
    }
    .hero-copy {
      grid-area: copy;
    }
    .hero-portrait {
      grid-area: portrait;
      justify-self: end;
    }
    .hero-heading {
      max-width: 13ch;
      margin-bottom: 0.75rem;
      font-size: clamp(2.5rem, 3.4vw, 3rem);
      line-height: 1.12;
    }
    .actions {
      gap: 0.625rem;
      margin-top: 0;
    }
    .actions :global(.button) {
      min-height: 2.65rem;
    }
  }
  :global(.bento-card.about > header) {
    margin-bottom: 1.375rem;
  }
  :global(.bento-card.about > p) {
