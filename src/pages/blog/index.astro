---
import ArchiveIntro from '../../components/astro/ArchiveIntro.astro';
import CardGrid from '../../components/astro/CardGrid.astro';
import CollectionHeader from '../../components/astro/CollectionHeader.astro';
import Layout from '../../components/astro/Layout.astro';
import BlogCard from '../../components/astro/BlogCard.astro';
import Tag from '../../components/astro/Tag.astro';
import { formatPageTitle } from '../../lib/data/pageTitle';
import { getPublicBlogCatalog } from '../../lib/server/blog';
import { getPublicSiteSettings } from '../../lib/server/siteSettings';

export const prerender = false;
const [posts, settings] = await Promise.all([
  getPublicBlogCatalog(),
  getPublicSiteSettings(),
]);
const categories = [...new Set(posts.map((post) => post.category))].sort();
const tags = [...new Set(posts.flatMap((post) => post.tags))].sort();
---

<Layout title={formatPageTitle('Blog', settings.name)} siteSettings={settings}>
  <CollectionHeader active="blog" />
  <ArchiveIntro
    id="blog-title"
    path="/blog"
    title="Blog"
    count={`${posts.length} published ${posts.length === 1 ? 'post' : 'posts'}`}
    asideTitle="Longer-form writing"
  >
    {
      categories.length > 0 && (
        <div class="archive-topic">
          <strong>Categories</strong>
          <p>{categories.join(', ')}</p>
        </div>
      )
    }
    {
      tags.length > 0 && (
        <div class="archive-topic">
          <strong>Tags</strong>
          <div class="archive-tags">
            {tags.map((tag) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        </div>
      )
    }
  </ArchiveIntro>
  <section aria-label="Blog archive">
    {
      posts.length ? (
        <CardGrid class="collection-grid blog-archive-grid">
          {posts.map((post) => (
            <BlogCard
              href={`/blog/${post.slug}`}
              title={post.title}
              description={post.description}
              summary={post.summary}
              cover={post.cover}
              category={post.category}
              tags={post.tags}
              createdAt={post.createdAt}
              updatedAt={post.updatedAt}
              featured={post.featured}
              context="archive"
            />
          ))}
        </CardGrid>
      ) : (
        <p class="empty-state">No published posts yet.</p>
      )
    }
  </section>
</Layout>

<style>
  :global(.collection-grid .content-card) {
    height: 100%;
    border-radius: var(--radius-md);
    box-shadow: none;
  }
  :global(.blog-archive-grid.collection-grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 767px) {
    :global(.blog-archive-grid.collection-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .empty-state {
    margin: 0;
    padding: 2rem;
    border: 1px dashed var(--border);
    background: var(--card);
    color: var(--muted-foreground);
    font: 1rem/1.65 var(--type-body);
  }
</style>
