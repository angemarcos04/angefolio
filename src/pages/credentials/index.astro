---
import CollectionHeader from '../../components/astro/CollectionHeader.astro';
import CredentialEntry from '../../components/astro/CredentialEntry.astro';
import Layout from '../../components/astro/Layout.astro';
import { getVisibleCredentials } from '../../lib/data/credentialPresentation';
import type { HomepageCredentialType } from '../../lib/data/homepage';
import { formatPageTitle } from '../../lib/data/pageTitle';
import { getHomepageConfig } from '../../lib/server/homepage';
import { getPublicSiteSettings } from '../../lib/server/siteSettings';

export const prerender = false;

const [homepage, settings] = await Promise.all([
  getHomepageConfig(),
  getPublicSiteSettings(),
]);
const credentials = getVisibleCredentials(homepage.credentials);
const filterTypes: { type: HomepageCredentialType; label: string }[] = [
  { type: 'certification', label: 'Certifications' },
  { type: 'digital_badge', label: 'Digital badges' },
  { type: 'course', label: 'Courses' },
  { type: 'training', label: 'Training' },
  { type: 'license', label: 'Licenses' },
];
const filters = [
  { value: 'all', label: 'All' },
  ...filterTypes
    .filter(({ type }) =>
      credentials.some((credential) => credential.type === type),
    )
    .map(({ type, label }) => ({ value: type, label })),
];
const countLabel = (count: number) =>
  `${count} ${count === 1 ? 'credential' : 'credentials'}`;
---

<Layout
  title={formatPageTitle('Credentials', settings.name)}
  description={`Public credentials and badges held by ${settings.name}.`}
  canonical="/credentials"
  siteSettings={settings}
>
  <CollectionHeader />

  <header
    class="credential-intro subtle-grid"
    aria-labelledby="credentials-title"
  >
    <p class="credential-eyebrow">~/credentials</p>
    <h1 id="credentials-title">Credentials</h1>
  </header>

  <section class="credentials-archive" aria-labelledby="credentials-title">
    {
      credentials.length > 0 ? (
        <div class="credential-layout">
          <aside class="credential-filter-panel" data-pagefind-ignore>
            <h2 class="credential-filter-heading">FILTER</h2>
            <div
              class="credential-filters"
              role="group"
              aria-label="Filter credentials"
              hidden
            >
              {filters.map(({ value, label }, index) => (
                <button
                  type="button"
                  class="credential-filter"
                  data-filter={value}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span>{label}</span>
                </button>
              ))}
            </div>
          </aside>

          <div class="credential-results">
            <p
              class="credential-result-count"
              aria-live="polite"
              data-pagefind-ignore
            >
              {countLabel(credentials.length)}
            </p>
            <div class="credential-list" id="credential-list">
              {credentials.map((credential) => (
                <CredentialEntry {credential} />
              ))}
            </div>
            <p class="credential-filter-empty" hidden>
              No credentials in this category.
            </p>
          </div>
        </div>
      ) : (
        <p class="empty-state">No public credentials yet.</p>
      )
    }
  </section>
</Layout>

<script>
  const filterBar = document.querySelector<HTMLDivElement>(
    '.credential-filters',
  );
  const credentialList =
    document.querySelector<HTMLDivElement>('#credential-list');
  const resultCount = document.querySelector<HTMLParagraphElement>(
    '.credential-result-count',
  );
  const filteredEmpty = document.querySelector<HTMLParagraphElement>(
    '.credential-filter-empty',
  );

  if (filterBar && credentialList && resultCount && filteredEmpty) {
    const rows = Array.from(
      credentialList.querySelectorAll<HTMLElement>('.credential-row'),
    );
    filterBar.hidden = false;
    filterBar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        'button[data-filter]',
      );
      if (!button || !filterBar.contains(button)) return;
      const filter = button.dataset.filter ?? 'all';
      for (const option of filterBar.querySelectorAll<HTMLButtonElement>(
        'button[data-filter]',
      )) {
        option.setAttribute('aria-pressed', String(option === button));
      }
      let count = 0;
      for (const row of rows) {
        const matches =
          filter === 'all' || row.dataset.credentialType === filter;
        row.hidden = !matches;
        if (matches) count += 1;
      }
      resultCount.textContent = `${count} ${count === 1 ? 'credential' : 'credentials'}`;
      filteredEmpty.hidden = count !== 0;
    });
  }
</script>

<style>
  .credential-intro {
    min-width: 0;
    margin-bottom: 1rem;
    padding: clamp(1.1rem, 2.5vw, 1.8rem);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent-hover);
    border-radius: var(--radius-md);
    background-color: var(--card);
  }
  .credential-eyebrow {
    margin: 0 0 0.4rem;
    color: var(--accent-text);
    font: 0.7rem/1.4 var(--font-mono);
  }
  .credential-intro h1 {
    margin: 0;
    color: var(--foreground);
    font: 700 clamp(1.8rem, 3.2vw, 2.625rem)/1.15 var(--type-heading);
    letter-spacing: -0.025em;
  }
  .credentials-archive,
  .credential-layout,
  .credential-results {
    min-width: 0;
  }
  .credential-layout {
    display: grid;
    align-items: start;
    gap: 1rem;
  }
  .credential-filter-panel {
    min-width: 0;
    padding: 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
  }
  .credential-filter-heading {
    margin: 0 0 0.55rem;
    color: var(--subtle-foreground);
    font: 600 0.66rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
  }
  .credential-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .credential-filters[hidden],
  .credential-filter-empty[hidden] {
    display: none;
  }
  .credential-filter {
    display: inline-flex;
    min-width: 0;
    min-height: 2.5rem;
    align-items: center;
    justify-content: flex-start;
    padding: 0.5rem 0.65rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-foreground);
    font: 0.73rem/1.3 var(--type-ui);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }
  .credential-filter:hover,
  .credential-filter[aria-pressed='true'] {
    border-color: var(--border-strong);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .credential-filter[aria-pressed='true'] {
    border-left: 2px solid var(--accent);
  }
  .credential-filter:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .credential-result-count {
    margin: 0 0 0.55rem;
    color: var(--subtle-foreground);
    font: 0.7rem/1.4 var(--font-mono);
  }
  .credential-list {
    display: grid;
    gap: 0.5rem;
  }
  .credential-filter-empty,
  .empty-state {
    margin: 0;
    padding: 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--muted-foreground);
    font: 0.92rem/1.6 var(--type-body);
  }
  @media (min-width: 1024px) {
    .credential-layout {
      grid-template-columns: minmax(190px, 220px) minmax(0, 1fr);
      gap: 1.15rem;
    }
    .credential-filters {
      display: grid;
      gap: 0.2rem;
    }
  }
  @media (max-width: 1023px) {
    .credential-filter-panel {
      padding: 0;
      border: 0;
      background: transparent;
    }
    .credential-filter-heading {
      margin-bottom: 0.45rem;
    }
  }
  @media (max-width: 479px) {
    .credential-intro {
      padding: 1rem;
    }
    .credential-filter {
      padding-inline: 0.6rem;
      font-size: 0.7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .credential-filter {
      transition: none;
    }
  }
</style>
