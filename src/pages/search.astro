---
import ArchiveIntro from '../components/astro/ArchiveIntro.astro';
import CollectionHeader from '../components/astro/CollectionHeader.astro';
import Layout from '../components/astro/Layout.astro';
import SearchBox from '../components/svelte/SearchBox.svelte';
import { formatPageTitle } from '../lib/data/pageTitle';
import { getPublicSiteSettings } from '../lib/server/siteSettings';

export const prerender = false;

const settings = await getPublicSiteSettings();
---

<Layout
  title={formatPageTitle('Search', settings.name)}
  siteSettings={settings}
>
  <CollectionHeader active="search" />
  <ArchiveIntro
    id="search-title"
    path="/search"
    title="Search"
    asideTitle="Browse the archive"
  >
    <nav class="archive-links" aria-label="Browse sections">
      <a href="/projects">Projects →</a>
      <a href="/notes">Notes →</a>
      <a href="/blog">Blog →</a>
      <a href="/lab">Lab →</a>
    </nav>
  </ArchiveIntro>
  <section aria-labelledby="search-title">
    <SearchBox client:load />
    <noscript>
      Search requires JavaScript in the browser. Projects, Notes, Blog, and Lab
      remain available through the primary navigation.
    </noscript>
  </section>
</Layout>

<style>
  noscript {
    display: block;
    margin-top: 1rem;
    padding: 1rem;
    border: 1px dashed var(--border);
    color: var(--muted-foreground);
    font: 0.875rem/1.6 var(--type-body);
  }
</style>
