{
  "name": "angefolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist/client",
    "index": "pagefind --site dist/client",
    "build:search": "astro build && pagefind --site dist/client",
    "preview": "astro preview",
    "start": "node scripts/start.mjs",
    "astro": "astro",
    "check": "astro check",
    "test:terminal": "tsx --test tests/terminal.test.ts",
    "test:unit": "tsx --test tests/content-card-presentation.test.ts tests/content-preview.test.ts tests/project-links.test.ts tests/credentials.test.ts tests/markdown-images.test.ts tests/media-fields.test.ts tests/media-reference.test.ts tests/migration-upgrade.test.ts tests/site-settings.test.ts tests/redirects.test.ts tests/mdx-slug.test.ts",
    "test:console": "tsx --test tests/console.integration.test.ts",
    "test:blog": "tsx --test tests/blog.integration.test.ts",
    "test:importers": "tsx --test tests/importers.integration.test.ts",
    "test:redirects": "tsx --test tests/redirects.integration.test.ts tests/redirect-lifecycle.integration.test.ts",
    "test:slug-collisions": "tsx --test tests/slug-collisions.integration.test.ts",
    "test:revision-atomicity": "tsx --test tests/revision-atomicity.integration.test.ts",
    "test:revision-slug-ownership": "tsx --test tests/revision-slug-ownership.integration.test.ts",
    "test:browser:authoring": "tsx scripts/run-authoring-browser-tests.ts",
    "test:backup": "node --test tests/offsite-backup.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "node scripts/db-maintenance.mjs backup",
    "db:verify": "node scripts/db-maintenance.mjs verify",
    "db:restore": "node scripts/db-maintenance.mjs restore",
    "console:bootstrap": "tsx scripts/create-admin.ts",
    "console:recover": "tsx scripts/recover-owner.ts",
    "projects:import": "tsx scripts/import-projects.ts",
    "notes:import": "tsx scripts/import-notes.ts",
    "lab:import": "tsx scripts/import-lab.ts",
    "docker:build": "docker build -t angefolio .",
    "docker:run": "docker run --rm --env-file .env -p 4321:4321 -v angefolio_data:/app/data angefolio"
  },
  "dependencies": {
    "@astrojs/mdx": "latest",
    "@astrojs/node": "^11.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "latest",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/inconsolata": "^5.2.8",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "astro-expressive-code": "latest",
    "better-auth": "^1.6.23",
    "clsx": "latest",
    "drizzle-orm": "^0.45.2",
    "lucide-svelte": "latest",
    "marked": "^18.0.14",
    "pagefind": "latest",
    "sanitize-html": "^2.18.0",
    "sharp": "latest",
    "svelte": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "^1.61.1",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "prettier-plugin-svelte": "latest",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
